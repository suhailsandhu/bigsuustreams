{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/basketball/streams",
      "destination": "https://strmfree.st/api/v1/streams?category=basketball"
    },
    {
      "source": "/api/basketball/stream/:key",
      "destination": "https://strmfree.st/api/v1/streams/:key"
    },
    {
      "source": "/api/basketball/sources/:key",
      "destination": "https://strmfree.st/api/v1/sources/:key"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
